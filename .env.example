# ========= BACKEND =========
PORT=8080
DATABASE_URL=postgres://travel_user:change_me@localhost:5432/travel?sslmode=disable
JWT_SECRET=replace_with_a_long_random_string_32_plus_chars
REFRESH_SECRET=replace_with_another_long_random_string
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 64 hex chars (32 byte)

# iyzico Sandbox — PROD'A GEÇERKEN DEĞİŞECEK
IYZICO_API_KEY=sandbox_API_KEY
IYZICO_SECRET_KEY=sandbox_SECRET_KEY
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
FRONTEND_URL=http://localhost:3000

# SMTP (transactional mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@travelagency.local

# S3 uyumlu object storage (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=tour-images
S3_USE_PATH_STYLE=true

# Rate limit ve uygulama
RATE_LIMIT_PER_MIN=120
